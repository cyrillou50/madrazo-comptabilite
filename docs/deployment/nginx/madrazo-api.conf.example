# Installer dans /etc/nginx/sites-available/madrazo-api après validation.
# Ce fichier suppose que le certificat existe déjà. Ne pas l'activer tel quel avant
# d'avoir vérifié les chemins et exécuté `nginx -t`.

limit_req_zone $binary_remote_addr zone=madrazo_login:10m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name api-madrazo.code-eternal.fr;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api-madrazo.code-eternal.fr;

    ssl_certificate /etc/letsencrypt/live/api-madrazo.code-eternal.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api-madrazo.code-eternal.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 2m;
    access_log /var/log/nginx/madrazo-api.access.log;
    error_log /var/log/nginx/madrazo-api.error.log warn;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    location = /api/auth/login {
        limit_req zone=madrazo_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3002;
        include proxy_params;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:3002;
        include proxy_params;
        proxy_http_version 1.1;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 30s;
    }
}

