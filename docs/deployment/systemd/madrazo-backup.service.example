[Unit]
Description=Sauvegarde logique MariaDB de Comptabilité Madrazo
Documentation=file:///opt/madrazo/current/docs/deployment/backups.md
After=mariadb.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/opt/madrazo/current/scripts/backup-database.sh --database madrazo --defaults-file /etc/madrazo/backup.cnf --output-dir /var/backups/madrazo
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/madrazo
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

